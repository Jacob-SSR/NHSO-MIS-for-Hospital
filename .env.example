# Copy to .env and fill in, then: docker compose up -d
# Client_ID / Secret from the MOPH Notify CMS (กลุ่มบอท -> รูปตา ที่ช่อง API Key) for the LINE group "Planfin HC10909"
MOPH_NOTIFY_CLIENT_KEY=
MOPH_NOTIFY_SECRET_KEY=

# Optional: link button under each LINE message, e.g. http://192.168.1.10:5200/?view=smt
DASHBOARD_URL=

# Optional overrides
# HCODE=10909
# NOTIFY_INTERVAL_MINUTES=30
# SMT_DATA_TIME=07:10
# MIS_DATA_TIME=07:25
